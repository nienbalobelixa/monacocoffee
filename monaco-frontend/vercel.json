{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_URL": "/api",
    "VITE_APP_NAME": "Monaco Coffee"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://monacocoffee.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}